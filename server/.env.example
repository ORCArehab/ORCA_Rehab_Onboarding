# --- Supabase ---------------------------------------------------------------
# Project Settings → API in the Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — it belongs only in
# this backend's environment. Never put it in the frontend or commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private bucket holding driver's license photos and resumes. Created by
# supabase/schema.sql; only change this if you renamed the bucket.
SUPABASE_UPLOADS_BUCKET=onboarding-uploads

# Postgres connection string, used only for persistent admin login sessions.
# Project Settings → Database → Connection string.
#
# On Vercel or any serverless host you MUST use the pooled "Connection pooling"
# URI (port 6543, host starts with aws-...pooler.supabase.com), not the direct
# connection below. Each invocation opens its own connection, and direct
# Postgres runs out of slots quickly.
#
# Leave blank to fall back to in-memory sessions. That's fine for local dev, but
# on serverless it means logins silently never persist.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

PORT=4000

# Only set this if the frontend is hosted on a DIFFERENT domain than the API.
# On a single Vercel deployment they share an origin, so leave it blank: that
# turns off CORS and keeps the login cookie on SameSite=Lax instead of None.
FRONTEND_ORIGIN=

# Set to "production" when deployed (not local dev). Switches the admin
# login cookie to Secure + SameSite=None, required for the frontend and
# backend to share a login session when hosted on different domains.
NODE_ENV=development

# Encrypts the SSN and other sensitive employee details at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-a-64-character-hex-string

# Signs the HR/Payroll admin login session. Any long random string works.
SESSION_SECRET=replace-with-a-long-random-string

# --- HR/Payroll admin login (Google Workspace SSO) --------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application). Set the OAuth consent screen's user type to
# "Internal" so only accounts in your Workspace org can sign in at all — that
# alone keeps outsiders out. Add this exact Authorized redirect URI:
#   {APP_URL}/api/admin/login/google/callback
# e.g. http://localhost:5173/api/admin/login/google/callback for local dev.
GOOGLE_CLIENT_ID=replace-with-your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-oauth-client-secret

# Your company's Workspace domain, e.g. orcarehab.com. Used to (a) pre-select
# the right account in Google's picker and (b) as a fallback access check —
# see ADMIN_ALLOWED_EMAILS below.
GOOGLE_WORKSPACE_DOMAIN=

# --- Shared ORCA roles (recommended) ---------------------------------------
# With these set, access is decided by roles in the shared ORCA API, granted
# in the employee portal at /admin/people: PROVIDER to fill out onboarding,
# HR or ADMIN for the HR/Payroll dashboard. Without them, anyone on
# GOOGLE_WORKSPACE_DOMAIN can fill out onboarding. With them set,
# ADMIN_ALLOWED_EMAILS below is ignored. Access is
# re-checked every minute, so revoking a role locks someone out quickly.
# ORCA_API_KEY must equal ONBOARDING_API_KEY in the API, and GOOGLE_CLIENT_ID
# above must be listed in the API's GOOGLE_CLIENT_IDS.
ORCA_API_URL=
ORCA_API_KEY=

# Used only when ORCA_API_URL is unset (e.g. local dev).
# Optional, comma-separated list of the specific Google accounts allowed into
# the HR/Payroll dashboard, e.g. hr@orcarehab.com,payroll@orcarehab.com.
# Recommended: this dashboard holds SSNs and other PII, and "Internal" consent
# screens admit your WHOLE Workspace org, not just HR/Payroll. Leave blank to
# fall back to allowing anyone on GOOGLE_WORKSPACE_DOMAIN instead — and if
# both are blank, nobody can log in.
ADMIN_ALLOWED_EMAILS=

# Optional: AI-checks each credentialing document (board certificate, DEA
# certificate, professional liability, state medical license, BLS/ACLS
# certificates) against what it's supposed to be at submit time, and rejects
# the submission with a clear error if one looks wrong (e.g. a driver's
# license uploaded where a DEA certificate was expected). Leave blank to skip
# this check entirely — nothing breaks, uploads just aren't verified.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Defaults to gpt-5.4-mini if unset. Override if you want a different model.
OPENAI_MODEL=

# Optional: email notification to HR/Payroll when a new submission arrives.
# Leave blank to skip notifications entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
# Where HR/Payroll logs in — this is the frontend's /admin route, not the backend.
ADMIN_DASHBOARD_URL=http://localhost:5173/admin

# The frontend's own base URL (e.g. https://onboarding.orcarehab.com) — used
# to build the Google redirect URI and to send providers back here after they
# sign in. Link to it from Resources in the employee portal. Defaults to
# http://localhost:5173 if unset.
APP_URL=http://localhost:5173
